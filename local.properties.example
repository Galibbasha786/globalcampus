# Local Configuration Template for LPU GlobalCampus
# Copy this file to local.properties and fill in your actual credentials.

sdk.dir=/Users/username/Library/Android/sdk

# Cloudinary CDN Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Google Gemini AI API Key (from Google AI Studio - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Agora Real-Time Video Calling Credentials (from https://console.agora.io)
AGORA_APP_ID=your_agora_app_id_here
AGORA_TEMP_TOKEN=your_agora_temp_token_here
